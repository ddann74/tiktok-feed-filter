<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a">

    <!-- Fixed (non-scrolling) quick-jump bar - with 12+ sections stacked in one long
         scroll below, reaching Diagnostics at the bottom used to mean scrolling past
         everything else every single time. Stays on screen while mainScrollView scrolls
         underneath it, wired up in MainActivity.setupQuickJumpNav(). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101010"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView android:id="@+id/navChipFilters" style="@style/QuickJumpChip" android:text="Filters" />
            <TextView android:id="@+id/navChipBlockedCreators" style="@style/QuickJumpChip" android:text="Blocked" />
            <TextView android:id="@+id/navChipAdKeywords" style="@style/QuickJumpChip" android:text="Ad Keywords" />
            <TextView android:id="@+id/navChipSubjectBoost" style="@style/QuickJumpChip" android:text="Subject Boost" />
            <TextView android:id="@+id/navChipTargetPackages" style="@style/QuickJumpChip" android:text="Packages" />
            <TextView android:id="@+id/navChipRealTikTok" style="@style/QuickJumpChip" android:text="Block/Download" />
            <TextView android:id="@+id/navChipLiveStreams" style="@style/QuickJumpChip" android:text="Live" />
            <TextView android:id="@+id/navChipActivity" style="@style/QuickJumpChip" android:text="Activity" />
            <TextView android:id="@+id/navChipDiagnostics" style="@style/QuickJumpChip" android:text="Diagnostics" />

        </LinearLayout>

    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TikTok Feed Filter"
            android:textSize="24sp"
            android:textColor="#00c853"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Accessibility Service: checking..."
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#2a2a2a"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/openAccessibilitySettingsButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Open Accessibility Settings"
        android:textColor="#ffffff"
        android:textAllCaps="false"
        android:backgroundTint="#2979ff"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filters"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip ads"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/adSkipSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip blocked creators"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/blockedCreatorSkipSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip videos I've watched too many times"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/repeatViewSkipSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Off by default - a brand-new, unverified-against-a-real-device heuristic (matches on creator + a guessed caption, since TikTok exposes no real per-video ID to accessibility services). Turn on and watch Diagnostic Log's FILTER entries to confirm it's identifying videos correctly before relying on it."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip after this many views"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/repeatViewLimitInput"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:inputType="number"
            android:gravity="center"
            android:textColor="#ffffff"
            android:background="#2a2a2a"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/saveRepeatViewLimitButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Save"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/resetRepeatViewHistoryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Reset History"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#c62828" />

    </LinearLayout>

    <TextView
        android:id="@+id/sectionBlockedCreators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blocked Creators"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the creator's display name exactly as it appears on their profile (not their @username) - TikTok doesn't expose @usernames to accessibility services, only the display name."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/blockedCreatorInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Display name"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addBlockedCreatorButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/toggleSelectModeButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Select"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:backgroundTint="#2979ff"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/removeSelectedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Remove Selected"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:backgroundTint="#ff1744"
            android:visibility="gone"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/blockedCreatorsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionAdKeywords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ad Keywords"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Matched against any on-screen text, case-insensitive. If TikTok changes its ad label, add the new wording here - no app update needed."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/adKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Sponsored"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addAdKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/adKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionSubjectBoost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subject Boost"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Never skips or blocks anything - browsing stays completely normal. When on, any video whose caption/hashtags mention a subject below gets auto-liked, as a positive signal toward TikTok's own recommendation algorithm showing you more of it. Auto-likes are visible in your account's Liked list and can notify the creator - HONEST LIMIT: this can only nudge a known signal, not guarantee or verify any actual shift in what gets recommended."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Auto-like videos about my subjects"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/subjectFilterSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/subjectKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="history"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addSubjectKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/subjectKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="“Like” Button Labels"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/likeOptionKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Like"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addLikeOptionKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/likeOptionKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionTargetPackages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target App Packages"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Which installed app(s) this is allowed to read/act on. Defaults cover standard and regional TikTok - add TikTok Lite's package here if you use that instead."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/targetPackageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="com.zhiliaoapp.musically"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addTargetPackageButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/targetPackagesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionRealTikTok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Real TikTok Integration"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="These automate real taps inside TikTok's own menus (block, save video) rather than just reading the screen - more powerful, and more likely to need a keyword tweak below if TikTok changes its button wording."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Really block in TikTok (not just skip)"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/realBlockSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Show floating Block/Download buttons"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/overlaySwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="“More Options” Button Labels"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/moreOptionsKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="More options"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addMoreOptionsKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/moreOptionsKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="“Block” Menu Option Labels"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/blockOptionKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Block"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addBlockOptionKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/blockOptionKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Block Confirmation Dialog Labels"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/blockConfirmKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Block"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addBlockConfirmKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/blockConfirmKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="“Download/Save” Menu Option Labels"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/downloadOptionKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Save video"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addDownloadOptionKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloadOptionKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/sectionLiveStreams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Streams"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TikTok Live rooms use a different on-screen layout than a normal video, so this is handled separately - see the README's Live streams section. Downloading isn't offered here since a live broadcast has no saved video file to grab."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip Live streams from blocked creators"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/liveStreamSkipSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Indicator Keywords"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What FilterEngine.isLiveStream looks for to decide a screen is a Live room at all - just &quot;LIVE&quot; by default, TikTok's own badge. If Live detection is misfiring (e.g. a normal video's &quot;Live now&quot; preview rail getting mistaken for actually being inside a Live room), tune this list."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/liveIndicatorKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="LIVE"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addLiveIndicatorKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveIndicatorKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Room Menu Entry Labels"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/liveMoreOptionsKeywordInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="More"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="#2a2a2a"
            android:padding="8dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/addLiveMoreOptionsKeywordButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:backgroundTint="#00c853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveMoreOptionsKeywordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activity"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/adsSkippedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ads skipped: 0"
            android:textColor="#ffffff"
            android:textSize="12.5sp"
            android:padding="10dp"
            android:background="#2a2a2a"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/creatorsSkippedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Creators skipped: 0"
            android:textColor="#ffffff"
            android:textSize="12.5sp"
            android:padding="10dp"
            android:background="#2a2a2a"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/audioExtractedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Audio saved: 0"
            android:textColor="#ffffff"
            android:textSize="12.5sp"
            android:padding="10dp"
            android:background="#2a2a2a"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/subjectBoostLikesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subject Boost auto-likes: 0"
        android:textColor="#ffffff"
        android:textSize="12.5sp"
        android:padding="10dp"
        android:background="#2a2a2a"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/repeatViewsSkippedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Repeat views skipped: 0"
        android:textColor="#ffffff"
        android:textSize="12.5sp"
        android:padding="10dp"
        android:background="#2a2a2a"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/activityLogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No activity yet"
        android:textColor="#cccccc"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="8dp"
        android:background="#2a2a2a"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/clearStatsButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Clear Activity &amp; Counters"
        android:textColor="#ffffff"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:backgroundTint="#ff1744"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/sectionDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diagnostics"
        android:textSize="18sp"
        android:textColor="#00c853"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A more technical log than Activity above - every screen evaluation (including the raw text it read), every automation stage attempt, and any errors. Off by default since it's verbose; turn on when troubleshooting or tuning a keyword list, then share it if you need help, or clear it when done."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2a2a2a"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable diagnostic logging"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/diagnosticLoggingSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <TextView
        android:id="@+id/diagnosticLogSizeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diagnostic log: 0 KB"
        android:textColor="#cccccc"
        android:textSize="12sp"
        android:padding="10dp"
        android:background="#2a2a2a"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shareDiagnosticLogButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Share Diagnostic Log"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="12.5sp"
            android:backgroundTint="#2979ff"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/clearDiagnosticLogButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Clear Diagnostic Log"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="12.5sp"
            android:backgroundTint="#ff1744"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    </LinearLayout>

    </ScrollView>

</LinearLayout>
